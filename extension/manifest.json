{
  "manifest_version": 3,
  "name": "new table",
  "version": "1.0.0",
  "description": "一个按域名整理当前标签页的新标签页扩展，支持便捷访问、稍后处理和重复标签清理。",
  "homepage_url": "https://github.com/huozhirui/new-tab",
  "permissions": ["tabs", "activeTab", "storage"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "new table",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
